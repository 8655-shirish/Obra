# Supabase (Lovable Cloud)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only operational credentials. Configure deployed values in Lovable Cloud.
AGENT_LOGS_TOKEN=
MIGRATION_RUNNER_SECRET=

# Obra product (Bucket 1+)
# Server-only AI provider token. Never expose it using a VITE_ variable.
AI_API_KEY=
AI_BASE_URL=https://consilium.workday.lovable.app/api/public/v1
AI_MODEL=openai/gpt-5.6-sol
FIRECRAWL_API_KEY=
ADMIN_USERNAME=obra@shr.com
ADMIN_PASSWORD=

# Required by the Lovable/Supabase cron and POST /api/internal/run-jobs.
# Store the same value in Supabase Vault as JOB_RUNNER_SECRET.
JOB_RUNNER_SECRET=
# Historical HMAC fields. Site builds persist without a Chrome QA stamp; these are unused
# on the generate → save → preview → Go live path.
BUCKET1_ATTESTATION_KEY_ID=
BUCKET1_ATTESTATION_SECRET=

# Bucket 1 independent monitor. Schedule POST /api/cron/generation-monitor every minute from
# infrastructure outside Supabase pg_cron so scheduler silence remains independently detectable.
GENERATION_MONITOR_SECRET=
GENERATION_ALERT_WEBHOOK_URL=
GENERATION_ALERT_WEBHOOK_TOKEN=

# Calendar assessment uses the SAME protected monitor endpoint and GENERATION_MONITOR_SECRET.
# Operations/authority/acceptance: docs/runbooks/calendar-observability.md.
# An external every-minute caller is a separate deployment step, not pg_cron self-monitoring.
# Calendar failures cannot skip generation; false/unset preserves generation-only behavior.
CALENDAR_MONITOR_ENABLED=false
CALENDAR_MONITOR_ENVIRONMENT=
# HTTPS only, redirects rejected. Assign real operator/destination labels before enabling.
CALENDAR_ALERT_WEBHOOK_URL=
CALENDAR_ALERT_WEBHOOK_TOKEN=
CALENDAR_ALERT_OWNER=
CALENDAR_ALERT_CHANNEL=
# Separately opt into unattended contractor action email after migration and acceptance.
# Uses RESEND_API_KEY_TEST/LIVE + BOOKING_EMAIL_FROM_TEST/LIVE for the exact monitor environment.
# PUBLIC_APP_URL must be canonical https://obratech.co; no owner session/appointment required.
CALENDAR_ACTION_NOTICES_ENABLED=false

# Required by the daily Lovable/Supabase orphan-sweeper cron and its HTTP endpoint.
# Store the same value in Supabase Vault as ADD_VIDEO_ORPHAN_SWEEPER_SECRET.
ADD_VIDEO_ORPHAN_SWEEPER_SECRET=

# Server-only admin secret for POST /api/internal/repair-contractor-media
MEDIA_REPAIR_SECRET=
# Optional read-only token: allows dryRun inspection only
MEDIA_DIAGNOSTICS_SECRET=

# Optional: HMAC secret for owner `/lp` preview links (falls back to JOB_RUNNER_SECRET or service role key)
PREVIEW_TOKEN_SECRET=

# Media uses the same AI_API_KEY and defaults to AI_BASE_URL. Override the base only
# when media is served by a different OpenAI-compatible host. Prompt-to-image uses
# POST /images/generations. Image editing is not implemented by current app flows.
AI_MEDIA_BASE_URL=https://consilium.workday.lovable.app/api/public/v1
AI_IMAGE_MODEL=openai/gpt-image-2
# Video remains disabled unless both values are explicitly configured.
AI_VIDEO_BASE_URL=
AI_VIDEO_MODEL=

# Required for Pipedream Connect and recommended for publish/workspace links; bare origin only
# Canonical production origin: https://obratech.co (the Lovable alias redirects).
PUBLIC_APP_URL=

# Stripe SaaS checkout (test mode first)
# All Checkout Session creation is disabled unless this deployment-owned gate is exactly true.
SAAS_CHECKOUT_ENABLED=false
# Deployment-owned billing authority: must match the Stripe secret-key mode. Production uses live.
SAAS_BILLING_ENVIRONMENT=test
# Live Checkout Session creation additionally requires this exact opt-in. Keep false until authorized.
SAAS_LIVE_CHARGING_ENABLED=false
# Paid-checkout OTP fulfillment worker remains disabled until an explicit schedule/worker rollout.
SAAS_CHECKOUT_FULFILLMENT_WORKER_ENABLED=false
# Signed Stripe event processing also remains off until an explicit worker/schedule rollout.
SAAS_STRIPE_INBOX_WORKER_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Same server-only value in Vault; never place a bearer in cron command text.
STRIPE_INBOX_CRON_SECRET=

# Bucket 2 Pipedream Connect (server-only; development/test first)
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
# Connect name_slug (underscore). Display name is "Google Calendar"; URL path may be google-calendar.
PIPEDREAM_GOOGLE_CALENDAR_APP_SLUG=google_calendar
# Same server-only value in Vault. BOOKING_WORKER_ENVIRONMENT scopes Google maintenance:
# test -> Pipedream development; live -> production. No automatic environment switching.
PIPEDREAM_INBOX_CRON_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Bucket 3 remains disabled until hosted migrations and provider acceptance are complete.
BOOKING_RATE_LIMIT_SECRET=
BOOKING_CONFIRMATION_SECRET=
# off stops servicing; drain services existing obligations without enabling new booking admission.
BOOKING_WORKER_MODE=off
BOOKING_WORKER_ENVIRONMENT=test
# Same server-only value in Vault. Legacy CRON_SECRET fallback does not configure the scheduler.
BOOKING_CRON_SECRET=
SUPABASE_BOOKING_WORKER_KEY=
# Invocation budget: clamped to 10000..45000 ms, settlement reserve to 3000..5000 ms.
# These are code budgets, not verified hosting/runtime capacity. See the calendar runbook gaps.
CALENDAR_WORKER_BUDGET_MS=45000
CALENDAR_WORKER_SETTLEMENT_MS=5000
# Vault-only scheduler config, documented here for provisioning; empty means not activatable.
# Allowed origin is exactly https://obratech.co (no slash; the redirecting Lovable alias is rejected).
# Environment must equal runtime BOOKING_WORKER_ENVIRONMENT and SAAS_BILLING_ENVIRONMENT.
CALENDAR_WORKER_CRON_ORIGIN=
CALENDAR_WORKER_CRON_ENVIRONMENT=
RESEND_API_KEY_TEST=
RESEND_API_KEY_LIVE=
BOOKING_EMAIL_FROM_TEST=
BOOKING_EMAIL_FROM_LIVE=
RESEND_WEBHOOK_SECRET=
BOOKING_ATTACHMENT_ENVIRONMENT=test
BOOKING_SCANNER_PROVIDER=
BOOKING_SCANNER_URL=
BOOKING_SCANNER_TOKEN=
BOOKING_SCANNER_CREDENTIAL_VERSION=
BOOKING_SCANNER_PROOF_SECRET=
ADMIN_RATE_LIMIT_SECRET=
ADMIN_AUTH_FLOW_SECRET=
ADMIN_RECOVERY_SECRET=
ADMIN_BOOTSTRAP_SECRET=
CRON_SECRET=
# Separate admission/charging gate. Registering/activating maintenance never changes it.
BOOKING_LIVE_ENABLED=false

# Feature flags
UNIFIED_SCHEMA_V3_WRITE_ENABLED=false
ADD_VIDEO_ENABLED=false
